{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
fish_path=$(command -v fish)
current_shell=$(dscl . -read /Users/"$(id -un)" UserShell | awk '$1 == "UserShell:" { print $2 }')

if [ "$current_shell" = "$fish_path" ]; then
	exit 0
fi

if ! grep -qxF "$fish_path" /etc/shells; then
	printf 'Registering Fish as a login shell (macOS may ask for your password).\n'
	printf '%s\n' "$fish_path" | sudo tee -a /etc/shells >/dev/null
fi

printf 'Setting Fish as your default shell (macOS may ask for your password).\n'
chsh -s "$fish_path"
printf 'Fish is now your default shell. Log out and back in to use it.\n'
{{ end -}}
