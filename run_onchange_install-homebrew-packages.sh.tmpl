{{- if eq .chezmoi.os "darwin" -}}
{{- $brewfile := joinPath .chezmoi.sourceDir "Brewfile" -}}
{{- $windowsCrossBuild := index . "windowsCrossBuild" | default false -}}
#!/bin/sh
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
# Windows cross-build: {{ $windowsCrossBuild }} {{ include "Brewfile.windows-cross" | sha256sum }}

set -e

if ! command -v brew >/dev/null 2>&1; then
	NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
	if [ -x "$candidate" ]; then
		eval "$("$candidate" shellenv)"
		break
	fi
done

brew bundle --file="{{ $brewfile }}"
{{- if $windowsCrossBuild }}
brew bundle --file="{{ joinPath .chezmoi.sourceDir "Brewfile.windows-cross" }}"
{{- end }}
{{- end -}}
