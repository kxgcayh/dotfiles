#!/usr/bin/env python3
"""Mirror ai-memory session pages into the Devault Obsidian vault.

Reads (never writes) the local ai-memory wiki and writes notes into the vault:
  Projects/<repo>/Sessions/<date> <title>.md   one per agent session (generated)
  Projects/<repo>/Knowledge/<page>.md          ai-memory curated pages (generated)
  Projects/<repo>/<repo>.md                    hub; only the marker block is regenerated
  Languages/<Lang>.md                          hub; only the marker block is regenerated
  Daily/<date>.md                              only the marker block is regenerated

Paths are resolved per machine, so the same script works on every Mac:
  vault:   $DEVAULT_VAULT, ~/.config/devault/config.json "vault", Obsidian's vault list
  memory:  $AI_MEMORY_DATA_DIR, config "ai_memory", ~/Library/Application Support/ai-memory

Usage: devault-sync [--dry-run] [--since 30d | --all] [--where]
"""

import argparse
import datetime as dt
import json
import os
import re
import socket
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config/devault/config.json"
STATE = HOME / ".local/state/devault-sync/state.json"
VAULT_NAME = "Devault"
CURATED_DIRS = ("gotchas", "decisions", "notes", "concepts")
SKIP_PROJECTS = {"projects", "scratch", "tmp", "devault", HOME.name.lower()}
SKIP_PREFIXES = ("/var/folders/", "/tmp/", "/private/")
BEGIN, END = "<!-- devault:begin -->", "<!-- devault:end -->"

# (marker file or glob, language). Order sets display order.
LANG_RULES = [
    ("pubspec.yaml", "Dart"),
    ("Package.swift", "Swift"),
    ("*.xcodeproj", "Swift"),
    ("Cargo.toml", "Rust"),
    ("go.mod", "Go"),
    ("pyproject.toml", "Python"),
    ("requirements.txt", "Python"),
    ("setup.py", "Python"),
    ("astro.config.*", "Astro"),
    ("tsconfig.json", "TypeScript"),
    ("CMakeLists.txt", "C++"),
    ("build.gradle*", "Java"),
    ("init.lua", "Lua"),
    ("*.lua", "Lua"),
    ("config.fish", "Fish"),
]


def load_json(path, default):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def resolve_vault():
    if os.environ.get("DEVAULT_VAULT"):
        return Path(os.environ["DEVAULT_VAULT"]).expanduser()
    cfg = load_json(CONFIG, {})
    if cfg.get("vault"):
        return Path(cfg["vault"]).expanduser()
    obs = load_json(HOME / "Library/Application Support/obsidian/obsidian.json", {})
    for v in obs.get("vaults", {}).values():
        p = Path(v.get("path", ""))
        if p.name == VAULT_NAME and p.is_dir():
            return p
    sys.exit(f"devault-sync: vault not found. Set DEVAULT_VAULT or 'vault' in {CONFIG}")


def resolve_memory():
    if os.environ.get("AI_MEMORY_DATA_DIR"):
        return Path(os.environ["AI_MEMORY_DATA_DIR"]).expanduser()
    cfg = load_json(CONFIG, {})
    if cfg.get("ai_memory"):
        return Path(cfg["ai_memory"]).expanduser()
    return HOME / "Library/Application Support/ai-memory"


def machine_name():
    try:
        out = subprocess.run(["scutil", "--get", "LocalHostName"], capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return socket.gethostname().split(".")[0]


# ---------- tiny frontmatter helpers (flat keys only, no PyYAML needed) ----------

def split_frontmatter(text):
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---", 4)
    if end < 0:
        return {}, text
    fm = {}
    for line in text[4:end].splitlines():
        m = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", line)
        if m:
            fm[m.group(1)] = m.group(2).strip().strip('"')
    body = text[end + 4:].lstrip("\n")
    return fm, body


def yaml_str(s):
    return json.dumps(str(s), ensure_ascii=False)


def render_frontmatter(fields):
    lines = ["---"]
    for k, v in fields.items():
        if isinstance(v, list):
            lines.append(f"{k}:")
            lines.extend(f"  - {yaml_str(x)}" for x in v)
        elif isinstance(v, bool):
            lines.append(f"{k}: {'true' if v else 'false'}")
        else:
            lines.append(f"{k}: {yaml_str(v)}")
    lines.append("---")
    return "\n".join(lines) + "\n"


def lang_tag(lang):
    return "lang/" + lang.lower().replace("+", "p")


def safe_name(s, limit=70):
    s = re.sub(r"[\\/:*?\"<>|#^\[\]\n\r\t]+", " ", s)
    s = re.sub(r"\s+", " ", s).strip(" .")
    s = s[:limit].rstrip(" .")
    if s.lower().endswith(".md"):
        s = s[:-3].rstrip(" .")
    return s or "untitled"


def parse_ts(s):
    try:
        return dt.datetime.fromisoformat(s.replace("Z", "+00:00")).astimezone()
    except (ValueError, AttributeError):
        return None


# ---------- writing ----------

class Writer:
    def __init__(self, dry):
        self.dry = dry
        self.changed = []

    def write(self, path, text):
        try:
            if path.read_text() == text:
                return False
        except OSError:
            pass
        self.changed.append(path)
        if self.dry:
            return True
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".devault-", suffix=".tmp")
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, path)
        return True


def is_generated(path):
    try:
        fm, _ = split_frontmatter(path.read_text())
    except OSError:
        return True  # missing file: ours to create
    return fm.get("generated") == "true"


def upsert_block(writer, path, header, block):
    """Create path with header+block, or replace only the marker block."""
    section = f"{BEGIN}\n{block.rstrip()}\n{END}\n"
    try:
        text = path.read_text()
    except OSError:
        return writer.write(path, header.rstrip() + "\n\n" + section)
    if BEGIN in text and END in text:
        pre, rest = text.split(BEGIN, 1)
        post = rest.split(END, 1)[1].lstrip("\n")
        new = pre + section + (("\n" + post) if post else "")
    else:
        new = text.rstrip() + "\n\n" + section
    return writer.write(path, new)


# ---------- ai-memory model ----------

def detect_languages(repo_path, cache):
    if not repo_path:
        return []
    if repo_path in cache:
        return cache[repo_path]
    root = Path(repo_path)
    if not root.is_dir():
        return []  # keep uncached; repo may be on an unmounted volume
    found = []
    for pattern, lang in LANG_RULES:
        if lang in found:
            continue
        if any(root.glob(pattern)):
            found.append(lang)
    if "package.json" in os.listdir(root) and not {"TypeScript", "Astro"} & set(found):
        found.append("JavaScript")
    if "TypeScript" in found and "Astro" in found:
        found.remove("TypeScript")
    cache[repo_path] = found
    return found


def project_name(meta):
    ident = meta.get("identity", "")
    if ident:
        return safe_name(ident.rstrip("/").split("/")[-1])
    return safe_name(meta.get("project", "unknown"))


def skip_project(meta):
    name = meta.get("project", "").lower()
    rp = meta.get("repo_path", "")
    if name in SKIP_PROJECTS or name.startswith(("scratch-", "tmp.")):
        return True
    if rp and (rp.startswith(SKIP_PREFIXES) or Path(rp) == HOME):
        return True
    if rp and ("ObsidianVault" in rp or "iCloud~md~obsidian" in rp or rp.startswith(str(HOME / "Obsidian"))):
        return True
    return False


# A session whose first prompt looks like this was started by another agent (Herdr worker);
# the leader's own session already covers the work, so it is skipped.
WORKER_START = re.compile(r"^(<hc[ >]|hc from=|You work on one Herdr task|You are taking over task|"
                          r"You are a worker|herdr-news)", re.I)
# Prompts that are machine chatter, not something the person typed.
NOISE_PROMPT = re.compile(r"^(user-prompt$|<hc[ >]|<hc>|<task-notification|<system-reminder|<command-|"
                          r"<local-command|herdr-news|\[Request interrupted)", re.I)


def is_worker_session(sess):
    return bool(sess["raw_prompts"]) and bool(WORKER_START.match(sess["raw_prompts"][0]))


def parse_session(text):
    fm, body = split_frontmatter(text)
    started = re.search(r"\*\*started_at:\*\*\s*(\S+)", body)
    ended = re.search(r"\*\*ended_at:\*\*\s*(\S+)", body)
    prompts = []
    m = re.search(r"^## Prompts\s*\n(.*?)(?=^## |\Z)", body, re.S | re.M)
    if m:
        for line in m.group(1).splitlines():
            pm = re.match(r"^\d+\.\s+(.*)", line)
            if pm:
                prompts.append(pm.group(1).strip())
            elif prompts and line.startswith("   "):
                prompts[-1] += " " + line.strip()
    raw = prompts
    prompts = [p for p in raw if not NOISE_PROMPT.match(p)]
    title = fm.get("title", "")
    if not title or NOISE_PROMPT.match(title):
        title = prompts[0] if prompts else ""
    return {
        "id": fm.get("session_id", ""),
        "raw_prompts": raw,
        "title": title[:120],
        "agent": fm.get("agent", "unknown"),
        "summary": fm.get("summary", ""),
        "started": parse_ts(started.group(1).strip("`")) if started else None,
        "ended": parse_ts(ended.group(1).strip("`")) if ended else None,
        "prompts": prompts,
    }


def vault_index(vault):
    """source_session -> path for generated session notes already in the vault."""
    idx = {}
    for p in (vault / "Projects").glob("*/Sessions/*.md"):
        try:
            fm, _ = split_frontmatter(p.read_text())
        except OSError:
            continue
        if fm.get("source_session"):
            idx[fm["source_session"]] = p
    return idx


# ---------- note builders ----------

def session_note(sess, repo, langs, host):
    when = sess["started"] or sess["ended"]
    fields = {
        "type": "session",
        "date": when.strftime("%Y-%m-%d") if when else "",
        "time": when.strftime("%H:%M") if when else "",
        "agent": sess["agent"],
        "project": f"[[{repo}]]",
        "languages": langs,
        "tags": ["session", f"agent/{sess['agent']}"] + [lang_tag(l) for l in langs],
        "machine": host,
        "source_session": sess["id"],
        "generated": True,
    }
    lines = [f"# {sess['title']}", ""]
    if sess["summary"]:
        lines += [f"> {sess['summary']}", ""]
    lang_links = ", ".join(f"[[{l}]]" for l in langs) or "unknown"
    lines += [f"Project: [[{repo}]] · Languages: {lang_links} · Agent: `{sess['agent']}`", ""]
    if sess["prompts"]:
        lines += ["## Prompts", ""]
        lines += [f"{i}. {p}" for i, p in enumerate(sess["prompts"], 1)]
        lines.append("")
    lines += ["## Notes", "", "_Generated by devault-sync; edits here are overwritten. Write learnings in Knowledge/ or Languages/._", ""]
    return render_frontmatter(fields) + "\n" + "\n".join(lines)


def collect_vault(vault):
    """Read notes back from the vault so hubs reflect every machine's notes."""
    sessions, knowledge = [], []
    for p in sorted((vault / "Projects").glob("*/Sessions/*.md")):
        fm, body = split_frontmatter(p.read_text())
        title = re.search(r"^# (.+)$", body, re.M)
        sessions.append({
            "path": p, "repo": p.parent.parent.name, "date": fm.get("date", ""),
            "time": fm.get("time", ""), "agent": fm.get("agent", ""),
            "title": title.group(1) if title else p.stem,
        })
    for p in sorted(vault.glob("Projects/*/Knowledge/*.md")) + sorted(vault.glob("Languages/*/*.md")):
        knowledge.append(p)
    return sessions, knowledge


def link(vault, p, alias=None):
    rel = p.relative_to(vault).as_posix()
    rel = rel[:-3] if rel.endswith(".md") else rel
    return f"[[{rel}|{alias}]]" if alias else f"[[{rel}]]"


def rebuild_hubs(vault, writer, project_langs):
    sessions, knowledge = collect_vault(vault)
    by_repo, by_day = {}, {}
    for s in sessions:
        by_repo.setdefault(s["repo"], []).append(s)
        if s["date"]:
            by_day.setdefault(s["date"], []).append(s)

    # Language membership: from this machine's detection plus hub frontmatter (other machines).
    langs_of = {}
    for repo_dir in (vault / "Projects").glob("*"):
        if not repo_dir.is_dir():
            continue
        repo = repo_dir.name
        hub = repo_dir / f"{repo}.md"
        found = list(project_langs.get(repo, []))
        if hub.exists():
            fm_raw = hub.read_text()
            m = re.search(r"^languages:\n((?:  - .*\n)+)", fm_raw, re.M)
            if m:
                for x in re.findall(r'  - "?([^"\n]+)"?', m.group(1)):
                    if x not in found:
                        found.append(x)
        langs_of[repo] = found

    for repo, langs in langs_of.items():
        repo_dir = vault / "Projects" / repo
        hub = repo_dir / f"{repo}.md"
        hub_fm = render_frontmatter({"type": "project", "languages": langs,
                                     "tags": ["project"] + [lang_tag(l) for l in langs]})
        header = hub_fm + f"\n# {repo}\n\nYour notes about this project go here; the block below is regenerated.\n"
        rows = sorted(by_repo.get(repo, []), key=lambda s: (s["date"], s["time"]), reverse=True)
        know = [p for p in knowledge if p.parent == repo_dir / "Knowledge"]
        block = ["## Languages", "", ", ".join(f"[[{l}]]" for l in langs) or "_unknown_", ""]
        if know:
            block += ["## Knowledge", ""] + [f"- {link(vault, p, p.stem)}" for p in know] + [""]
        block += [f"## Sessions ({len(rows)})", ""]
        block += [f"- {s['date']} {s['time']} `{s['agent']}` {link(vault, s['path'], s['title'])}" for s in rows[:50]]
        if len(rows) > 50:
            block.append(f"- …and {len(rows) - 50} older in `Sessions/`")
        if hub.exists():
            # Refresh the languages list only while the hub keeps the frontmatter we created.
            text = hub.read_text()
            if text.startswith('---\ntype: "project"'):
                _, body = split_frontmatter(text)
                writer.write(hub, hub_fm + "\n" + body)
        upsert_block(writer, hub, header, "\n".join(block))

    all_langs = sorted({l for ls in langs_of.values() for l in ls} |
                       {p.parent.name for p in knowledge if p.parts[-3] == "Languages"})
    for lang in all_langs:
        hub = vault / "Languages" / f"{lang}.md"
        header = render_frontmatter({"type": "language", "tags": ["language"]}) + f"\n# {lang}\n\nYour notes about {lang} go here; the block below is regenerated.\n"
        repos = sorted(r for r, ls in langs_of.items() if lang in ls)
        notes = [p for p in knowledge if p.parent == vault / "Languages" / lang]
        block = ["## Projects", ""] + ([f"- [[{r}]]" for r in repos] or ["_none yet_"]) + [""]
        block += ["## Notes", ""] + ([f"- {link(vault, p, p.stem)}" for p in notes] or ["_none yet_"])
        upsert_block(writer, hub, header, "\n".join(block))

    for day, rows in by_day.items():
        path = vault / "Daily" / f"{day}.md"
        header = render_frontmatter({"type": "daily", "date": day, "tags": ["daily"]}) + f"\n# {day}\n"
        rows = sorted(rows, key=lambda s: s["time"])
        block = ["## Agent sessions", ""]
        block += [f"- {s['time']} [[{s['repo']}]] `{s['agent']}` {link(vault, s['path'], s['title'])}" for s in rows]
        upsert_block(writer, path, header, "\n".join(block))

    home = vault / "Home.md"
    header = "# Home\n\nStart here. The block below is regenerated by devault-sync.\n"
    recent_days = sorted(by_day)[-7:][::-1]
    block = ["## Projects", ""] + [f"- [[{r}]]" for r in sorted(langs_of)] + [""]
    block += ["## Languages", ""] + [f"- [[{l}]]" for l in all_langs] + [""]
    block += ["## Recent days", ""] + [f"- [[Daily/{d}|{d}]]" for d in recent_days]
    upsert_block(writer, home, header, "\n".join(block))


# ---------- main ----------

def parse_since(s):
    m = re.fullmatch(r"(\d+)([dh])", s)
    if not m:
        raise argparse.ArgumentTypeError("use e.g. 30d or 12h")
    n = int(m.group(1))
    return dt.timedelta(days=n) if m.group(2) == "d" else dt.timedelta(hours=n)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dry-run", action="store_true", help="print planned writes, change nothing")
    ap.add_argument("--since", type=parse_since, help="only sessions changed in this window (e.g. 30d)")
    ap.add_argument("--all", action="store_true", help="process every session")
    ap.add_argument("--where", action="store_true", help="print this machine's vault path and exit")
    args = ap.parse_args()

    vault = resolve_vault()
    if args.where:
        print(vault)
        return
    if not vault.is_dir():
        sys.exit(f"devault-sync: vault {vault} is not mounted")
    memory = resolve_memory()
    wiki = memory / "wiki"

    state = load_json(STATE, {})
    cache = state.get("languages", {})
    now = dt.datetime.now().timestamp()
    if args.all:
        cutoff = 0.0
    elif args.since:
        cutoff = now - args.since.total_seconds()
    elif state.get("last_run"):
        cutoff = state["last_run"] - 3600  # overlap: sessions keep updating while open
    else:
        cutoff = now - 30 * 86400

    writer = Writer(args.dry_run)
    host = machine_name()
    project_langs = {}
    idx = vault_index(vault)

    if not wiki.is_dir():
        print(f"devault-sync: no ai-memory wiki at {wiki}; only rebuilding hubs", file=sys.stderr)
    for meta_path in sorted(wiki.glob("*/*/_meta.md")) if wiki.is_dir() else []:
        meta, _ = split_frontmatter(meta_path.read_text())
        if skip_project(meta):
            continue
        repo = project_name(meta)
        proj_dir = meta_path.parent
        langs = detect_languages(meta.get("repo_path", ""), cache)
        if langs:
            merged = project_langs.setdefault(repo, [])
            merged.extend(l for l in langs if l not in merged)

        for sp in sorted((proj_dir / "sessions").glob("*.md")):
            if sp.stat().st_mtime < cutoff:
                continue
            sess = parse_session(sp.read_text())
            if not sess["id"] or not sess["prompts"] or is_worker_session(sess):
                continue
            when = sess["started"] or sess["ended"] or dt.datetime.fromtimestamp(sp.stat().st_mtime)
            target = idx.get(sess["id"])
            if target is None:
                folder = vault / "Projects" / repo / "Sessions"
                stem = f"{when:%Y-%m-%d} {safe_name(sess['title'], 60)}"
                target, n = folder / f"{stem}.md", 2
                while target.exists():
                    target = folder / f"{stem} ({n}).md"
                    n += 1
                idx[sess["id"]] = target
            elif not is_generated(target):
                continue
            writer.write(target, session_note(sess, repo, langs or project_langs.get(repo, []), host))

        for sub in CURATED_DIRS:
            for cp in sorted((proj_dir / sub).glob("*.md")):
                target = vault / "Projects" / repo / "Knowledge" / (safe_name(cp.stem) + ".md")
                if target.exists() and not is_generated(target):
                    continue
                fm, body = split_frontmatter(cp.read_text())
                # ai-memory links curated pages as [[gotchas/x]]; in the vault they sit side by side.
                body = re.sub(r"\[\[(?:%s)/" % "|".join(CURATED_DIRS), "[[", body)
                head = render_frontmatter({"type": "knowledge", "kind": sub.rstrip("s"),
                                           "project": f"[[{repo}]]", "languages": langs,
                                           "tags": ["knowledge", f"kind/{sub.rstrip('s')}"],
                                           "source": "ai-memory", "generated": True})
                writer.write(target, head + "\n" + body)

    if args.dry_run:
        for p in writer.changed:
            print("would write", p.relative_to(vault))
        print(f"{len(writer.changed)} file(s) would change (hubs not computed in dry run)")
        return

    rebuild_hubs(vault, writer, project_langs)  # reads the session notes written above

    state["last_run"] = now
    state["languages"] = cache
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, indent=1))
    if writer.changed:
        print(f"devault-sync: {len(writer.changed)} file(s) updated in {vault}")


if __name__ == "__main__":
    main()
