{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# (Re)load the devault-sync launchd agent whenever its plist or script changes.
# plist hash: {{ include "private_Library/LaunchAgents/com.kautsar.devault-sync.plist.tmpl" | sha256sum }}
# script hash: {{ include "dot_local/bin/executable_devault-sync" | sha256sum }}
set -e
mkdir -p "$HOME/.local/state/devault-sync"
plist="$HOME/Library/LaunchAgents/com.kautsar.devault-sync.plist"
launchctl bootout "gui/$(id -u)/com.kautsar.devault-sync" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$plist"
echo "devault-sync: launchd agent loaded (vault: $("$HOME/.local/bin/devault-sync" --where 2>/dev/null || echo 'not found, set DEVAULT_VAULT'))"
{{ end -}}
