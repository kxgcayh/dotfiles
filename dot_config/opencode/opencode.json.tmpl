{
  "plugins": [
    "@dietrichgebert/ponytail",
    "@warp-dot-dev/opencode-warp"
  ],
  "mcp": {
    "servers": {
      "ai-memory": {
        "type": "local",
        "command": [
          "{{ .chezmoi.homeDir }}/.local/bin/ai-memory",
          "mcp-bridge",
          "--no-session-id",
          "--server-url",
          "http://127.0.0.1:49374/mcp"
        ]
      },
      "mobile-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mobilenext/mobile-mcp@latest"
        ],
        "environment": {}
      }
    }
  }
}
